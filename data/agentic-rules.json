{
  "version": 1,
  "_note": "SoDamAgentic 폴백 안전 규칙(데이터). 비개발자도 목록을 늘릴 수 있게 코드와 분리. guard.mjs가 런타임에 정규식으로 컴파일한다. 패턴은 대소문자 무시(i)로 적용된다.",

  "nudge": {
    "enabled": true,
    "_note": "계획 없이 코드 시도 시 '계획부터 볼까요?' 1회 ask(차단 아님). false로 끄기."
  },
  "plan_skip": {
    "enabled": true,
    "_note": "사소·저위험 작업은 계획을 생략(계획 피로 방지). 판단은 F2 스킬이 한다."
  },

  "plan": {
    "_note": "F2 계획 먼저 스킬이 참조하는 데이터. 비개발자가 fields/skip_when 항목을 늘릴 수 있다.",
    "fields": ["무엇을 만들까", "왜 필요한가", "완성 기준은 무엇인가"],
    "skip_when": ["오타 수정", "한 줄 변경", "단순 조회/읽기", "저위험 반복 작업"]
  },

  "key_exposure_deny": [
    "sk-ant-[A-Za-z0-9_\\-]{12,}",
    "sk-[A-Za-z0-9]{20,}",
    "\\b(curl|wget|scp|Invoke-WebRequest|Invoke-RestMethod)\\b[^|;&]*\\.env\\b",
    "ANTHROPIC_BASE_URL\\s*=",
    "\\becho\\b[^|;&]*\\$\\{?[A-Za-z_][A-Za-z0-9_]*(KEY|TOKEN|SECRET)",
    "echo\\b[^|;&]*%[A-Za-z_][A-Za-z0-9_]*(KEY|TOKEN|SECRET)%",
    "process\\.env\\.[A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD)[\\s\\S]*console\\.(log|error|info|warn)",
    "console\\.(log|error|info|warn)[\\s\\S]*process\\.env\\.[A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD)"
  ],
  "key_exposure_ask": [
    "\\b(cat|type|more|less|Get-Content)\\b[^|;&]*\\.env(\\b|$)"
  ],

  "extra_denied": [
    "\\bmklink\\b",
    "New-Item\\b[^|;&]*-ItemType\\s+(SymbolicLink|Junction|HardLink)",
    "\\bln\\s+-(?!-)[a-zA-Z]*s[a-zA-Z]*(?=\\s|$)"
  ],
  "extra_protected_paths": [],

  "family": {
    "_note": "6형제 시너지 메타데이터. guard.mjs는 이 키를 무시(런타임 영향 없음). 역할 경계·설치 순서 참조용.",
    "siblings": [
      { "name": "SoDamHarness", "role": "안전·백업·되돌리기",   "repo": "sodam-ai/SoDam-Harness-Eng" },
      { "name": "SoDamLoop",    "role": "자율 반복 엔진",       "repo": "sodam-ai/SoDam-Loop-Eng" },
      { "name": "SoDamContext", "role": "설명서 건강검진",       "repo": "sodam-ai/SoDam-Context-Eng" },
      { "name": "SoDamAgentic", "role": "진입점·계획·검토",     "repo": "sodam-ai/SoDam-Agentic-Eng" },
      { "name": "SoDamPrompt",  "role": "프롬프트 입문 웹앱",   "repo": "sodam-ai/SoDam-Prompt-Eng" },
      { "name": "SoDamReverse", "role": "코드·앱 분석 보고서", "repo": "sodam-ai/SoDam-Reverse-Eng" }
    ],
    "installation_order": ["SoDamHarness", "SoDamLoop", "SoDamContext", "SoDamAgentic", "SoDamPrompt", "SoDamReverse"],
    "hook_conflict_rule": "새 PreToolUse 훅 파일 추가 금지. 규칙은 Harness extra_denied/extra_protected_paths에 주입. bypassPermissions 권유 금지.",
    "synergy_doc": "docs/family-synergy.md"
  }
}
