# SoDamAgentic — Git 추적 제외 (보안: 비밀값·사용자 데이터 보호)

# 의존성 설치 폴더
node_modules/

# 비밀값·인증서 (절대 커밋 금지)
.env
.env.*
*.key
*.pem
*.p12
.claude/settings.local.json

# 영구 데이터·백업 (사용자 파일·잠재 민감정보)
.sodamagentic/

# Codex 설치 스크립트 출력 (사용자 프로젝트에 설치됨, 플러그인 repo엔 불필요)
.agents/

# Claude Code 외부 도구 자동 생성 파일 (플러그인 메타 아님)
.omc/
.plugin-config/
.complexity-log.md
.todos-report.md
.pair-programming-session.md

# 테스트 임시 산출물
_selftest.mjs
*.tmp

# OS·에디터 부산물
.DS_Store
Thumbs.db
*.log

# 기획 문서·로컬 메모 (사용자 지정 — 공개 저장소에 절대 push 금지)
/.PRD/
/.이 문서는 반드시 깃허브 저장소에 푸시 하지 않기.md

# 생성 PDF/HTML (소스=MD에서 재생성 가능 — 저장소엔 소스만 추적)
docs/*.pdf
docs/*.html

# 문서 HTML 생성용 pandoc 헤더 (로컬 빌드 입력 — 저장소엔 불필요)
.doc-html-header.html
